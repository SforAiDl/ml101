source 'https://rubygems.org'

# Matches the exact Jekyll + plugin versions GitHub Pages builds the site with,
# so a local preview renders the same as the deployed site.
gem 'github-pages', group: :jekyll_plugins
gem 'webrick', '~> 1.8'

# Ruby 3.4 removed these from the default gems, but the Jekyll version GitHub Pages
# builds with still expects them. Harmless on older Rubies.
gem 'base64'
gem 'bigdecimal'
gem 'csv'
gem 'logger'
